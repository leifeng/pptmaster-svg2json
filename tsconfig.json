{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/types/**/*", "src/parser/**/*", "src/shapes/**/*", "src/mapper/**/*", "src/transformer/**/*", "src/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__", "src/scripts"]
}
