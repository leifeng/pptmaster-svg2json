{
  "name": "svg-to-pptel",
  "version": "1.0.0",
  "description": "SVG to PPTElement JSON converter",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "svg2pptel": "./dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "npm run build && node -e \"const {execSync}=require('child_process');const r='release';execSync('rm -rf '+r+' && mkdir '+r+' && cp -r dist templates package.json README.md '+r+' && find '+r+'/dist -name \\\"*.map\\\" -delete');\""
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "cac": "^6.7.14",
    "fast-xml-parser": "^5.9.3",
    "picocolors": "^1.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
